{
  "uid": "pa-guard-slo",
  "title": "PriorAuthGuard — SLO",
  "tags": ["pa-guard", "slo"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Overall SLO status",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 4 },
      "targets": [
        { "expr": "pa_guard_slo_overall_status", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "value": "0", "text": "Met", "color": "green" },
            { "type": "value", "value": "1", "text": "At risk", "color": "yellow" },
            { "type": "value", "value": "2", "text": "Breached", "color": "red" }
          ]
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "value_and_name"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Denial rate",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 4 },
      "targets": [
        { "expr": "pa_guard_denial_rate", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 0.18, "color": "yellow" },
              { "value": 0.20, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "FHE-executed share",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 4 },
      "targets": [
        { "expr": "pa_guard_fhe_executed_share", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 0.75, "color": "yellow" },
              { "value": 0.80, "color": "green" }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Per-SLO status",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 8 },
      "targets": [
        {
          "expr": "pa_guard_slo_actual",
          "refId": "actual",
          "format": "table",
          "instant": true
        },
        {
          "expr": "pa_guard_slo_target",
          "refId": "target",
          "format": "table",
          "instant": true
        },
        {
          "expr": "pa_guard_slo_burn",
          "refId": "burn",
          "format": "table",
          "instant": true
        },
        {
          "expr": "pa_guard_slo_status",
          "refId": "status",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": { "byField": "slo_id" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "__name__ 1": true,
              "__name__ 2": true,
              "__name__ 3": true,
              "__name__ 4": true,
              "instance 1": true,
              "instance 2": true,
              "instance 3": true,
              "instance 4": true,
              "job 1": true,
              "job 2": true,
              "job 3": true,
              "job 4": true
            }
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Per-agent average latency",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "pa_guard_agent_avg_latency_ms",
          "legendFormat": "{{agent}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Per-agent success rate",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "pa_guard_agent_success_rate",
          "legendFormat": "{{agent}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Error-budget burn (≥ 1 is a breach)",
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 8 },
      "targets": [
        {
          "expr": "pa_guard_slo_burn",
          "legendFormat": "{{slo_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 0.9, "color": "yellow" },
              { "value": 1.0, "color": "red" }
            ]
          }
        }
      }
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
