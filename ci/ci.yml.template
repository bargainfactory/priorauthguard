name: CI

on:
  push:
    branches: [main]
    tags: ["v*.*.*"]
  pull_request:
    branches: [main]
  workflow_dispatch:
    inputs:
      run_live_sandbox:
        description: "Run live payer sandbox tests"
        required: false
        default: "true"

permissions:
  contents: read

jobs:
  # -----------------------------------------------------------------------
  # Backend — tests + lint on every PR.
  # -----------------------------------------------------------------------
  backend:
    name: Backend (Python ${{ matrix.python-version }})
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        python-version: ["3.11", "3.12"]
    defaults:
      run:
        working-directory: backend
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
          cache: pip
          cache-dependency-path: backend/pyproject.toml
      - run: |
          python -m pip install --upgrade pip
          pip install -e ".[dev]" aiosqlite
      - name: Lint
        run: ruff check pa_guard tests
      - name: Test
        env:
          PAG_ENVIRONMENT: test
        run: pytest -q --maxfail=1 --disable-warnings

  privacy-gates:
    name: Privacy / compliance gates
    runs-on: ubuntu-latest
    needs: backend
    defaults:
      run:
        working-directory: backend
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip
          cache-dependency-path: backend/pyproject.toml
      - run: |
          python -m pip install --upgrade pip
          pip install -e ".[dev]" aiosqlite
      - name: Safe Harbor + FRI regression suite
        env:
          PAG_ENVIRONMENT: test
        run: pytest -q -m compliance tests/test_fri.py

  # -----------------------------------------------------------------------
  # Frontend (web build).
  # -----------------------------------------------------------------------
  frontend:
    name: Frontend (Next.js)
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: frontend
    steps:
      - uses: actions/checkout@v4
      - uses: pnpm/action-setup@v4
        with: { version: 9 }
      - uses: actions/setup-node@v4
        with:
          node-version: "20"
          cache: pnpm
          cache-dependency-path: frontend/pnpm-lock.yaml
      - run: pnpm install --frozen-lockfile
      - run: pnpm lint
      - run: pnpm type-check
      - run: pnpm build

  # -----------------------------------------------------------------------
  # Playwright end-to-end — boots the backend + Next dev server,
  # runs the happy path through the actual browser.
  # -----------------------------------------------------------------------
  e2e:
    name: Playwright E2E
    runs-on: ubuntu-latest
    needs: [backend, frontend]
    services: {}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip
          cache-dependency-path: backend/pyproject.toml
      - run: |
          python -m pip install --upgrade pip
          pip install -e "./backend[dev]" aiosqlite
      - name: Boot backend
        working-directory: backend
        run: |
          uvicorn pa_guard.api.main:app --host 127.0.0.1 --port 8080 &
          echo $! > .pid
          for i in {1..30}; do
            curl -sf http://127.0.0.1:8088/readyz && break || sleep 1
          done
      - uses: pnpm/action-setup@v4
        with: { version: 9 }
      - uses: actions/setup-node@v4
        with:
          node-version: "20"
          cache: pnpm
          cache-dependency-path: frontend/pnpm-lock.yaml
      - name: Frontend deps + Playwright
        working-directory: frontend
        run: |
          pnpm install --frozen-lockfile
          pnpm e2e:install
      - name: Run E2E
        working-directory: frontend
        env:
          PAG_BACKEND_URL: http://127.0.0.1:8088
        run: pnpm e2e
      - if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: playwright-report
          path: frontend/playwright-report

  # -----------------------------------------------------------------------
  # Native Rust FRI prover/verifier — multi-platform wheel build.
  # Runs on every PR (build + self-test) and uploads wheels on tag.
  # -----------------------------------------------------------------------
  zkstark-native:
    name: zkstark-native (${{ matrix.os }})
    strategy:
      fail-fast: false
      matrix:
        include:
          - os: ubuntu-22.04
            wheel_target: manylinux
          - os: macos-14
            wheel_target: macos-arm64
          - os: macos-13
            wheel_target: macos-x86_64
          - os: windows-2022
            wheel_target: win_amd64
    runs-on: ${{ matrix.os }}
    defaults:
      run:
        working-directory: native/zkstark-accel
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: pip install maturin
      - name: Build wheel
        run: maturin build --release --strip
      - name: Self-test wheel
        run: |
          pip install --no-index --find-links=target/wheels zkstark_native
          python -c "import zkstark_native; assert zkstark_native._selftest()"
          python -c "
          import zkstark_native
          blob = zkstark_native.prove('m', 'a'*64, 'b'*64)
          assert zkstark_native.verify('m', 'a'*64, 'b'*64, blob)
          # tampered must reject
          assert not zkstark_native.verify('m', 'c'*64, 'b'*64, blob)
          "
      - if: startsWith(github.ref, 'refs/tags/v')
        uses: actions/upload-artifact@v4
        with:
          name: zkstark-native-${{ matrix.wheel_target }}
          path: native/zkstark-accel/target/wheels/*

  # -----------------------------------------------------------------------
  # Live payer sandbox tests — manual-only; needs provisioned secrets.
  # -----------------------------------------------------------------------
  live-sandbox:
    name: Payer live sandbox
    if: github.event_name == 'workflow_dispatch'
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: backend
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip
          cache-dependency-path: backend/pyproject.toml
      - run: |
          python -m pip install --upgrade pip
          pip install -e ".[dev]" aiosqlite
      - name: Run live sandbox suite
        env:
          PAG_RUN_LIVE_SANDBOX_TESTS: "true"
          PAG_PAYER_SANDBOX_MODE: "true"
          PAG_AVAILITY_CLIENT_ID: ${{ secrets.AVAILITY_CLIENT_ID }}
          PAG_AVAILITY_CLIENT_SECRET: ${{ secrets.AVAILITY_CLIENT_SECRET }}
          PAG_AVAILITY_BASE_URL: ${{ secrets.AVAILITY_BASE_URL }}
          PAG_COVERMYMEDS_API_KEY: ${{ secrets.COVERMYMEDS_API_KEY }}
          PAG_COVERMYMEDS_BASE_URL: ${{ secrets.COVERMYMEDS_BASE_URL }}
          PAG_SURESCRIPTS_CLIENT_ID: ${{ secrets.SURESCRIPTS_CLIENT_ID }}
          PAG_SURESCRIPTS_CLIENT_SECRET: ${{ secrets.SURESCRIPTS_CLIENT_SECRET }}
          PAG_SURESCRIPTS_BASE_URL: ${{ secrets.SURESCRIPTS_BASE_URL }}
          PAG_NHS_SPINE_API_KEY: ${{ secrets.NHS_SPINE_API_KEY }}
          PAG_NHS_SPINE_BASE_URL: ${{ secrets.NHS_SPINE_BASE_URL }}
        run: pytest -q -m live_sandbox tests/integration

  # -----------------------------------------------------------------------
  # Docker image — built on every tag, multi-arch, cosign-signed (keyless).
  # -----------------------------------------------------------------------
  docker:
    name: Docker (backend)
    runs-on: ubuntu-latest
    needs: [backend]
    if: startsWith(github.ref, 'refs/tags/v')
    permissions:
      contents: read
      packages: write
      id-token: write   # for cosign keyless signing
    steps:
      - uses: actions/checkout@v4
      - uses: docker/setup-qemu-action@v3
      - uses: docker/setup-buildx-action@v3
      - uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}
      - uses: docker/metadata-action@v5
        id: meta
        with:
          images: ghcr.io/${{ github.repository }}/backend
          tags: |
            type=ref,event=tag
            type=sha,prefix=,suffix=,format=short
      - uses: docker/build-push-action@v6
        id: build
        with:
          context: backend
          file: backend/Dockerfile
          platforms: linux/amd64,linux/arm64
          push: true
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
      - uses: sigstore/cosign-installer@v3
      - name: Sign image (keyless)
        env:
          DIGEST: ${{ steps.build.outputs.digest }}
        run: |
          for tag in $(echo "${{ steps.meta.outputs.tags }}" | tr ',' '\n'); do
            cosign sign --yes "$tag@${DIGEST}"
          done

  # -----------------------------------------------------------------------
  # Tauri desktop bundles — Linux, macOS (x86_64 + arm64), Windows.
  # -----------------------------------------------------------------------
  tauri:
    name: Tauri (${{ matrix.os }})
    if: startsWith(github.ref, 'refs/tags/v')
    needs: [frontend]
    strategy:
      fail-fast: false
      matrix:
        include:
          - os: ubuntu-22.04
            target: x86_64-unknown-linux-gnu
          - os: macos-14
            target: aarch64-apple-darwin
          - os: macos-13
            target: x86_64-apple-darwin
          - os: windows-2022
            target: x86_64-pc-windows-msvc
    runs-on: ${{ matrix.os }}
    defaults:
      run:
        working-directory: frontend
    steps:
      - uses: actions/checkout@v4
      - uses: pnpm/action-setup@v4
        with: { version: 9 }
      - uses: actions/setup-node@v4
        with:
          node-version: "20"
          cache: pnpm
          cache-dependency-path: frontend/pnpm-lock.yaml
      - uses: dtolnay/rust-toolchain@stable
        with:
          targets: ${{ matrix.target }}
      - name: Install Tauri Linux deps
        if: matrix.os == 'ubuntu-22.04'
        run: |
          sudo apt-get update
          sudo apt-get install -y libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev librsvg2-dev
      - run: pnpm install --frozen-lockfile

      # Import Apple Developer ID certificate (macOS signed builds).
      - name: Import Apple signing cert
        if: startsWith(matrix.os, 'macos')
        env:
          APPLE_CERT_P12: ${{ secrets.APPLE_CERT_P12_B64 }}
          APPLE_CERT_PASSWORD: ${{ secrets.APPLE_CERT_PASSWORD }}
        run: |
          echo "$APPLE_CERT_P12" | base64 -d > cert.p12
          security create-keychain -p "" build.keychain
          security default-keychain -s build.keychain
          security unlock-keychain -p "" build.keychain
          security import cert.p12 -k build.keychain -P "$APPLE_CERT_PASSWORD" -T /usr/bin/codesign
          security set-key-partition-list -S apple-tool:,apple: -s -k "" build.keychain

      - name: Tauri build
        env:
          # macOS notarization (post-build).
          APPLE_ID: ${{ secrets.APPLE_ID }}
          APPLE_PASSWORD: ${{ secrets.APPLE_APP_SPECIFIC_PASSWORD }}
          APPLE_TEAM_ID: ${{ secrets.APPLE_TEAM_ID }}
          APPLE_SIGNING_IDENTITY: ${{ secrets.APPLE_SIGNING_IDENTITY }}
          TAURI_SIGNING_PRIVATE_KEY: ${{ secrets.TAURI_SIGNING_PRIVATE_KEY }}
          TAURI_SIGNING_PRIVATE_KEY_PASSWORD: ${{ secrets.TAURI_SIGNING_PRIVATE_KEY_PASSWORD }}
        run: pnpm tauri build --target ${{ matrix.target }}

      - uses: actions/upload-artifact@v4
        with:
          name: tauri-${{ matrix.os }}-${{ matrix.target }}
          path: |
            frontend/src-tauri/target/${{ matrix.target }}/release/bundle/**/*

  # -----------------------------------------------------------------------
  # Capacitor Android signed APK.
  # -----------------------------------------------------------------------
  android:
    name: Capacitor Android
    if: startsWith(github.ref, 'refs/tags/v')
    needs: [frontend]
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: frontend
    steps:
      - uses: actions/checkout@v4
      - uses: pnpm/action-setup@v4
        with: { version: 9 }
      - uses: actions/setup-node@v4
        with:
          node-version: "20"
          cache: pnpm
          cache-dependency-path: frontend/pnpm-lock.yaml
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"
      - run: pnpm install --frozen-lockfile
      - run: pnpm cap:sync
      - name: Decode Android keystore
        env:
          ANDROID_KEYSTORE_B64: ${{ secrets.ANDROID_KEYSTORE_B64 }}
        run: echo "$ANDROID_KEYSTORE_B64" | base64 -d > android/app/release.keystore
      - name: Gradle assembleRelease
        env:
          ANDROID_KEYSTORE_PASSWORD: ${{ secrets.ANDROID_KEYSTORE_PASSWORD }}
          ANDROID_KEY_ALIAS: ${{ secrets.ANDROID_KEY_ALIAS }}
          ANDROID_KEY_PASSWORD: ${{ secrets.ANDROID_KEY_PASSWORD }}
        working-directory: frontend/android
        run: ./gradlew assembleRelease
      - uses: actions/upload-artifact@v4
        with:
          name: android-release-apk
          path: frontend/android/app/build/outputs/apk/release/*.apk

  # -----------------------------------------------------------------------
  # Tauri update manifest — built only on tags. Generates the
  # `data/desktop-updates.json` minisign-signed manifest that the
  # backend's /v1/updates endpoint serves to the desktop auto-updater.
  # -----------------------------------------------------------------------
  desktop-updates-manifest:
    name: Sign + publish desktop update manifest
    if: startsWith(github.ref, 'refs/tags/v')
    needs: [tauri]
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: pip install -e ./backend
      - uses: actions/download-artifact@v4
        with:
          path: artifacts
      - name: Install minisign
        run: |
          sudo apt-get update
          sudo apt-get install -y minisign
      - name: Write keys to disk
        env:
          MINISIGN_SECRET_KEY: ${{ secrets.MINISIGN_SECRET_KEY }}
          MINISIGN_PUBKEY: ${{ secrets.MINISIGN_PUBKEY }}
        run: |
          printf '%s\n' "$MINISIGN_SECRET_KEY" > /tmp/minisign.key
          printf '%s\n' "$MINISIGN_PUBKEY"   > /tmp/minisign.pub
          chmod 600 /tmp/minisign.key
      - name: Compose manifest
        env:
          MINISIGN_PASSWORD: ${{ secrets.MINISIGN_PASSWORD }}
        run: |
          set -euo pipefail
          VERSION="${GITHUB_REF_NAME#v}"
          BASE_URL="https://releases.priorauthguard.com/desktop/${GITHUB_REF_NAME}"
          # Resolve the artifact paths the tauri matrix uploaded.
          # Each platform's directory is named tauri-<os>-<rust-target>.
          ARTIFACTS=()
          for dir in artifacts/tauri-*; do
            target=$(basename "$dir" | sed 's/^tauri-//' | sed 's/-.*//' )
            file=$(find "$dir" -type f \( -name "*.AppImage.tar.gz" -o -name "*.tar.gz" -o -name "*.zip" -o -name "*.nsis.zip" \) | head -1)
            [ -z "$file" ] && continue
            case "$target" in
              ubuntu)  TARGET=linux-x86_64 ;;
              macos)   TARGET=darwin-x86_64 ;;
              windows) TARGET=windows-x86_64 ;;
            esac
            ARTIFACTS+=("${TARGET}=${file}")
          done
          python -m scripts.publish_release_manifest \
            --version "$VERSION" \
            --base-url "$BASE_URL" \
            --secret-key /tmp/minisign.key \
            --pubkey /tmp/minisign.pub \
            --manifest-out data/desktop-updates.json \
            --artifacts "${ARTIFACTS[@]}"
        working-directory: backend
      - uses: actions/upload-artifact@v4
        with:
          name: desktop-updates-manifest
          path: backend/data/desktop-updates.json

  # -----------------------------------------------------------------------
  # GitHub release — publishes all signed binaries on a tag.
  # -----------------------------------------------------------------------
  release:
    name: GitHub release
    if: startsWith(github.ref, 'refs/tags/v')
    needs: [docker, tauri, android, desktop-updates-manifest]
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/download-artifact@v4
        with:
          path: artifacts
      - uses: softprops/action-gh-release@v2
        with:
          generate_release_notes: true
          files: artifacts/**/*
